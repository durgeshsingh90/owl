{
  "id": "payment-platform",
  "name": "Payment Platform",
  "description": "Payment processing platform: takes payments from the internet through central ingress, authorises them with the payment provider and posts them to the on-premises ledger.",
  "environments": {
    "DEV": {
      "account_id": "111111111111"
    },
    "STAGE": {
      "account_id": "111111111111"
    },
    "MTF": {
      "account_id": "222222222222"
    },
    "PROD": {
      "account_id": "222222222222"
    }
  },
  "shared_services": [
    "shared-auth"
  ],
  "central_services": [
    "central-ingress",
    "central-egress",
    "central-network"
  ],
  "applications": [
    {
      "id": "payment-api",
      "name": "Payment API",
      "description": "Containerised payment API behind an internal ALB.",
      "placement": {
        "DEV": {
          "account": "111111111111",
          "vpc": "vpc-0a11",
          "subnets": [
            "subnet-0a11dev-a"
          ],
          "security_groups": [
            "sg-0a11app"
          ],
          "load_balancer": "payments-nonprod-alb"
        },
        "STAGE": {
          "account": "111111111111",
          "vpc": "vpc-0a11",
          "subnets": [
            "subnet-0a11stg-a"
          ],
          "security_groups": [
            "sg-0a11app"
          ],
          "load_balancer": "payments-nonprod-alb"
        },
        "MTF": {
          "account": "222222222222",
          "vpc": "vpc-0b22",
          "subnets": [
            "subnet-0b22mtf-a"
          ],
          "security_groups": [
            "sg-0b22app"
          ],
          "load_balancer": "payments-mtf-alb"
        },
        "PROD": {
          "account": "222222222222",
          "vpc": "vpc-0b22",
          "subnets": [
            "subnet-0b22prd-a",
            "subnet-0b22prd-b"
          ],
          "security_groups": [
            "sg-0b22app"
          ],
          "load_balancer": "payments-prod-alb"
        }
      }
    },
    {
      "id": "admin-api",
      "name": "Admin API",
      "description": "Operations console API, production only.",
      "placement": {
        "PROD": {
          "account": "222222222222",
          "vpc": "vpc-0b22",
          "subnets": [
            "subnet-0b22prd-a"
          ],
          "security_groups": [
            "sg-0b22admin"
          ],
          "load_balancer": "payments-prod-alb"
        }
      }
    }
  ],
  "requirements": [
    {
      "id": "conn-001",
      "name": "Payment API outbound to provider",
      "environments": [
        "DEV",
        "STAGE",
        "MTF",
        "PROD"
      ],
      "source": "payment-api",
      "destination": "payment-provider",
      "direction": "outbound",
      "protocol": "TCP",
      "port": 443,
      "hostname": "api.payment-provider.com"
    },
    {
      "id": "conn-002",
      "name": "Payments inbound from Central Ingress",
      "environments": [
        "DEV",
        "STAGE",
        "MTF",
        "PROD"
      ],
      "source": "central-ingress",
      "destination": "payment-api",
      "direction": "inbound",
      "protocol": "TCP",
      "port": 1234,
      "target_port": 8080
    },
    {
      "id": "conn-003",
      "name": "Ledger posting to on-premises",
      "environments": [
        "DEV",
        "STAGE",
        "MTF",
        "PROD"
      ],
      "source": "payment-api",
      "destination": "corporate-datacenter",
      "direction": "outbound",
      "protocol": "TCP",
      "port": 8443,
      "hostname": "ledger.corp.example.com"
    },
    {
      "id": "conn-004",
      "name": "Token validation with Shared Auth",
      "environments": [
        "DEV",
        "STAGE",
        "MTF",
        "PROD"
      ],
      "source": "payment-api",
      "destination": "shared-auth",
      "direction": "outbound",
      "protocol": "HTTPS",
      "port": 443,
      "hostname": "auth.shared.internal"
    },
    {
      "id": "conn-005",
      "name": "Admin API inbound from Central Ingress",
      "environment": "PROD",
      "source": "central-ingress",
      "destination": "admin-api",
      "direction": "inbound",
      "protocol": "TCP",
      "port": 8443,
      "target_port": 9443
    },
    {
      "id": "conn-006",
      "name": "Sanctions screening",
      "environments": [
        "MTF",
        "PROD"
      ],
      "source": "payment-api",
      "destination": "sanctions-service",
      "direction": "outbound",
      "protocol": "HTTPS",
      "port": 443
    },
    {
      "id": "conn-007",
      "name": "Risk scoring over PrivateLink to EKS, then secure access",
      "environment": "PROD",
      "direction": "outbound",
      "protocol": "TCP",
      "port": 443,
      "hops": [
        {
          "kind": "workload",
          "id": "payment-api"
        },
        {
          "kind": "vpc-endpoint",
          "id": "vpce-0b22risk",
          "account": "222222222222"
        },
        {
          "kind": "endpoint-service",
          "id": "vpce-svc-0risk00000000001",
          "account": "333333333333"
        },
        {
          "kind": "load-balancer",
          "id": "risk-nlb",
          "account": "333333333333"
        },
        {
          "kind": "eks-cluster",
          "id": "risk-engine",
          "account": "333333333333",
          "port": 443
        },
        {
          "kind": "subnet",
          "id": "subnet-0f88pam-a",
          "account": "888888888888",
          "label": "Secure Access Gateway"
        }
      ]
    },
    {
      "id": "conn-008",
      "name": "Provider calls through the chosen NAT gateway",
      "environments": [
        "DEV",
        "STAGE"
      ],
      "direction": "outbound",
      "protocol": "TCP",
      "port": 443,
      "hostname": "api.payment-provider.com",
      "hops": [
        {
          "kind": "workload",
          "id": "payment-api"
        },
        {
          "kind": "tgw",
          "id": "tgw-0central0000001",
          "account": "666666666666"
        },
        {
          "kind": "firewall",
          "id": "egress-fw",
          "account": "555555555555"
        },
        {
          "kind": "nat-gateway",
          "id": "nat-0e55a",
          "account": "555555555555"
        },
        {
          "kind": "internet-gateway",
          "id": "igw-0e55",
          "account": "555555555555"
        },
        {
          "kind": "external",
          "id": "payment-provider"
        }
      ]
    }
  ],
  "aws_accounts": [
    {
      "account_id": "111111111111",
      "name": "payments-nonprod",
      "type": "application"
    },
    {
      "account_id": "222222222222",
      "name": "payments-prod",
      "type": "application"
    },
    {
      "account_id": "333333333333",
      "name": "shared-services",
      "type": "shared-services"
    },
    {
      "account_id": "444444444444",
      "name": "central-ingress",
      "type": "central-ingress"
    },
    {
      "account_id": "555555555555",
      "name": "central-egress",
      "type": "central-egress"
    },
    {
      "account_id": "666666666666",
      "name": "central-network",
      "type": "central-network"
    },
    {
      "account_id": "777777777777",
      "name": "dns",
      "type": "dns"
    },
    {
      "account_id": "888888888888",
      "name": "secure-access",
      "type": "secure-access"
    }
  ]
}
