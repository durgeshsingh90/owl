# OWL local configuration example
#
# Copy this file to .env. Never put a real PAT or another private value in this
# tracked example. Leaving DJANGO_SECRET_KEY blank makes OWL create a strong
# machine-local key under OWL_DATA_ROOT on first start.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO
OWL_LOG_LEVEL=INFO
# Detailed Bitbucket file logging; ERROR/CRITICAL also have a separate error log.
BITBUCKET_LOG_LEVEL=DEBUG
# Detailed Bookmark Manager events; failures also go to an ERROR/CRITICAL-only file.
BOOKMARK_LOG_LEVEL=DEBUG
# Shared local PDF/bookmark embedding worker diagnostics.
SEMANTIC_LOG_LEVEL=DEBUG
OWL_TIME_ZONE=Europe/Dublin
OWL_DATA_ROOT=var
OWL_LOG_MAX_BYTES=5242880
OWL_LOG_BACKUP_COUNT=3
OWL_ALLOW_NON_LOOPBACK=false
# Test-only escape hatch. Keep false during normal use.
OWL_ALLOW_IN_MEMORY_SECRET_STORE=false
SQLITE_TIMEOUT_SECONDS=30
DATA_UPLOAD_MAX_MEMORY_BYTES=2621440
FILE_UPLOAD_MAX_MEMORY_BYTES=2621440

# Optional environment-managed Confluence override.
# Leave BOTH values blank to configure Confluence later from Bookmark Manager.
# If one is supplied, the other is required. Never commit a real PAT.
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
CONFLUENCE_AUTH_MODE=bearer
# Auto prefers the operating-system credential store and falls back to an
# encrypted value in OWL's local SQLite database when that store is unavailable.
CONFLUENCE_SECRET_BACKEND=auto
CONFLUENCE_REQUEST_TIMEOUT_SECONDS=30
CONFLUENCE_MAX_RESPONSE_BYTES=1048576
CONFLUENCE_ACTION_COOLDOWN_SECONDS=2
CONFLUENCE_MAX_WORKERS=5
CONFLUENCE_REFRESH_INTERVAL_SECONDS=604800
CONFLUENCE_REFRESH_RETRY_SECONDS=7200
CONFLUENCE_REFRESH_SCHEDULER_POLL_SECONDS=60

# Test-only target exception for synthetic .invalid hosts or exact loopback fixture
# servers. Normal use must keep this false.
OWL_ALLOW_SYNTHETIC_CONFLUENCE_TARGETS=false

# Repository and document-sync defaults for Bitbucket Search. The separate
# Bitbucket app auto-approves each exact submitted HTTPS origin and does not need
# this setting. Uncomment only to replace Bitbucket Search's default host policy
# with an administrator-managed hostname list (not URLs or paths). It does not
# restrict the separate Bitbucket app. Restart OWL and its workers after changing it.
# BITBUCKET_ALLOWED_HOSTS=bitbucket.org,github.com,scm.example.invalid
# Saved HTTPS tokens use the OS credential store when available and otherwise
# encrypted local database storage. This may be set independently of Confluence.
BITBUCKET_SECRET_BACKEND=auto
BITBUCKET_HISTORY_YEARS=3
BITBUCKET_MAX_REPO_WORKERS=4
BITBUCKET_GIT_TIMEOUT_SECONDS=3600
BITBUCKET_CONNECTION_TIMEOUT_SECONDS=20
BITBUCKET_WORKER_IDLE_SECONDS=15
BITBUCKET_REPOSITORY_JOB_LEASE_SECONDS=90
BITBUCKET_REPOSITORY_WORKER_MAX_RETRIES=1
# Daily cycles follow OWL_TIME_ZONE. The retry cap is in addition to the initial attempt.
BITBUCKET_DAILY_REFRESH_ENABLED=true
BITBUCKET_DAILY_REFRESH_LOCAL_HOUR=11
BITBUCKET_DAILY_REFRESH_RETRY_SECONDS=7200
BITBUCKET_DAILY_REFRESH_MAX_RETRIES=3
BITBUCKET_PDF_PAGE_SIZE=500
BITBUCKET_SEARCH_PAGE_SIZE=100
BITBUCKET_APP_DAILY_REFRESH_ENABLED=true
BITBUCKET_APP_DAILY_REFRESH_LOCAL_HOUR=11
BITBUCKET_APP_PDF_PAGE_SIZE=500
BITBUCKET_APP_SEARCH_PAGE_SIZE=500
PDF_EXTRACTION_TIMEOUT_SECONDS=600
PDF_EXTRACTION_JOB_LEASE_SECONDS=90
PDF_EXTRACTION_WORKER_IDLE_SECONDS=15
PDF_EXTRACTION_MAX_AUTOMATIC_RETRIES=2
PDF_MAX_EXTRACTION_WORKERS=16
# Legacy dashboard warning threshold only; JSONL backlog never throttles extraction.
PDF_MAX_STAGED_PUBLICATIONS=16
PDF_MAX_ACTIVE_EXTRACTION_REPOSITORIES=1
PDF_MAX_EXTRACTION_WORKERS_PER_REPOSITORY=16
PDF_PIPELINE_REPOSITORY_FAIRNESS_MAX_WAIT_SECONDS=120
PDF_PIPELINE_REPOSITORY_WORK_CONSERVING=true
PDF_PIPELINE_REUSE_PARENT_FINGERPRINT=true
PDF_PUBLICATION_PAGE_BATCH_SIZE=100
PDF_JSONL_CHUNK_SIZE_BYTES=52428800
# Blank stores staging under OWL's private temporary data root.
PDF_JSONL_STAGING_DIRECTORY=
PDF_JSONL_RETENTION_DAYS=7
# Safe controller rollout. Fixed/observe/shadow retain the configured target;
# adaptive also requires the explicit opt-in and a passing representative gate.
PDF_PIPELINE_CONTROLLER_MODE=observe
PDF_PIPELINE_ADAPTIVE_ENABLED=false
PDF_PIPELINE_CONTROLLER_KILL_SWITCH=false
PDF_PIPELINE_MANUAL_FIXED_TARGET=
PDF_PIPELINE_CONFIGURED_MIN_TARGET=1
PDF_PIPELINE_INITIAL_TARGET=16
PDF_PIPELINE_TESTED_HARD_MAX=16
PDF_PIPELINE_BACKGROUND_CPU_BUDGET_FRACTION=0.80
PDF_PIPELINE_ADAPTIVE_BENCHMARK_GATE_PATH=
PDF_PIPELINE_CONTROLLER_OBSERVATION_SECONDS=60
PDF_PIPELINE_CONTROLLER_COOLDOWN_SECONDS=120
PDF_PIPELINE_CONTROLLER_HYSTERESIS_SAMPLES=3
PDF_PIPELINE_CONTROLLER_MIN_DOCUMENTS=3
PDF_PIPELINE_CONTROLLER_MIN_PAGES=10
PDF_PIPELINE_CONTROLLER_MIN_BYTES=1048576
PDF_PIPELINE_CONTROLLER_MAX_ORDINARY_DECREASE=2
PDF_PIPELINE_CONTROLLER_MIN_THROUGHPUT_IMPROVEMENT=0.05
PDF_PIPELINE_CONTROLLER_MAX_HOST_CPU_PCT=85
PDF_PIPELINE_CONTROLLER_MIN_AVAILABLE_MEMORY_BYTES=8589934592
PDF_PIPELINE_CONTROLLER_MIN_AVAILABLE_DISK_BYTES=10737418240
PDF_PIPELINE_CONTROLLER_MAX_FOREGROUND_P95_MS=500
PDF_PIPELINE_METRICS_ENABLED=true
PDF_PIPELINE_METRICS_SAMPLE_SECONDS=5
PDF_PIPELINE_METRICS_RETENTION_SECONDS=1800
PDF_PIPELINE_METRICS_SNAPSHOT_ENABLED=true
PDF_PIPELINE_METRICS_STALE_SECONDS=15
PDF_PIPELINE_RATE_WINDOW_SECONDS=60
PDF_PIPELINE_RATE_MIN_ELAPSED_SECONDS=30
PDF_PIPELINE_RATE_MIN_EVENTS=3
PDF_PIPELINE_SQLITE_LOCK_BLOCKED_MS=250
PDF_PIPELINE_ETA_MIN_COMPLETIONS=3
PDF_PIPELINE_ETA_STALE_SECONDS=30
PDF_PIPELINE_RECOVERY_ENABLED=true
PDF_PIPELINE_RECOVERY_PAUSE_AFTER_ATTEMPTS=25
PDF_PIPELINE_RECOVERY_BACKOFF_BASE_SECONDS=1
PDF_PIPELINE_RECOVERY_BACKOFF_MAX_SECONDS=300
PDF_PIPELINE_RECOVERY_JITTER_FRACTION=0.20
PDF_PIPELINE_RECOVERY_STABILITY_SECONDS=60
PDF_PIPELINE_RECOVERY_CORRELATION_WINDOW_SECONDS=10
PDF_PIPELINE_RECOVERY_ESCALATION_SLOT_COUNT=2
PDF_PIPELINE_COMPONENT_ERROR_LOOP_THRESHOLD=5
BITBUCKET_SUPERVISOR_POLL_SECONDS=5
OWL_KEEP_DISPLAY_AWAKE_DURING_BACKGROUND_WORK=true
PDF_MAX_FILE_BYTES=2147483648
PDF_MAX_PAGES=10000
PDF_MAX_PAGE_TEXT_CHARS=2000000
PDF_MAX_TOTAL_TEXT_CHARS=100000000
PDF_MAX_PROCESS_MEMORY_BYTES=1073741824

# Local semantic fallback for stored PDF and bookmark text. The first run downloads
# the pinned 67 MB retrieval model into OWL_DATA_ROOT/models/semantic; no source text
# is uploaded. Set offline after that download, or point at a provisioned model folder.
SEMANTIC_SEARCH_ENABLED=true
SEMANTIC_MODEL_ID=BAAI/bge-small-en-v1.5
SEMANTIC_MODEL_REPOSITORY=Qdrant/bge-small-en-v1.5-onnx-Q
SEMANTIC_MODEL_REVISION=c32e6154d1bb7a0e47c5e745fd895e7700f44385
SEMANTIC_MODEL_PATH=
SEMANTIC_MODEL_OFFLINE=false
# Each worker owns one local model session. Two or three workers are normally fastest
# without duplicating too much RAM; values above 4 are rejected.
SEMANTIC_MAX_WORKERS=2
SEMANTIC_EMBEDDING_BATCH_SIZE=64
SEMANTIC_CHUNK_MAX_CHARACTERS=1800
SEMANTIC_CHUNK_OVERLAP_CHARACTERS=180
SEMANTIC_WORKER_IDLE_SECONDS=15
SEMANTIC_JOB_LEASE_SECONDS=900
SEMANTIC_JOB_MAX_AUTOMATIC_RETRIES=2
SEMANTIC_JOB_RETRY_SECONDS=300
SEMANTIC_FAILED_RETRY_SECONDS=3600
SEMANTIC_SWEEP_BATCH_SIZE=500
# Slow safety-net scan for missed signals/backfill; ordinary edits queue immediately.
SEMANTIC_RECONCILE_SECONDS=60
SEMANTIC_SEARCH_TOP_K=250
SEMANTIC_RERANK_SOURCE_CANDIDATES=300
SEMANTIC_SEARCH_MIN_SCORE=0.55

# Display and safety thresholds.
NEW_DURATION_DAYS=30
UPDATED_DURATION_DAYS=30
OPEN_ALL_CONFIRM_THRESHOLD=10

# Live external tests are always off unless deliberately enabled on a local
# machine. Public CI overrides this value to false as an additional safeguard.
OWL_ALLOW_LIVE_EXTERNAL_TESTS=false
