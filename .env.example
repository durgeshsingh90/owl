# OWL local configuration example
#
# Copy this file to .env. Never put a real PAT or another private value in this
# tracked example. Leaving DJANGO_SECRET_KEY blank makes OWL create a strong
# machine-local key under OWL_DATA_ROOT on first start.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO
OWL_LOG_LEVEL=INFO
OWL_TIME_ZONE=Europe/Dublin
OWL_DATA_ROOT=var
OWL_LOG_MAX_BYTES=5242880
OWL_LOG_BACKUP_COUNT=3
OWL_ALLOW_NON_LOOPBACK=false
# Test-only escape hatch. Keep false during normal use.
OWL_ALLOW_IN_MEMORY_SECRET_STORE=false
SQLITE_TIMEOUT_SECONDS=30
DATA_UPLOAD_MAX_MEMORY_BYTES=2621440
FILE_UPLOAD_MAX_MEMORY_BYTES=2621440

# Optional environment-managed Confluence override.
# Leave BOTH values blank to configure Confluence later from Bookmark Manager.
# If one is supplied, the other is required. Never commit a real PAT.
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
CONFLUENCE_AUTH_MODE=bearer
# Auto prefers the operating-system credential store and falls back to an
# encrypted value in OWL's local SQLite database when that store is unavailable.
CONFLUENCE_SECRET_BACKEND=auto
CONFLUENCE_REQUEST_TIMEOUT_SECONDS=30
CONFLUENCE_MAX_RESPONSE_BYTES=1048576
CONFLUENCE_ACTION_COOLDOWN_SECONDS=2
CONFLUENCE_MAX_WORKERS=5
CONFLUENCE_REFRESH_INTERVAL_SECONDS=604800
CONFLUENCE_REFRESH_RETRY_SECONDS=7200
CONFLUENCE_REFRESH_SCHEDULER_POLL_SECONDS=60

# Test-only target exception for synthetic .invalid hosts or exact loopback fixture
# servers. Normal use must keep this false.
OWL_ALLOW_SYNTHETIC_CONFLUENCE_TARGETS=false

# Repository and document-sync defaults. Omit BITBUCKET_ALLOWED_HOSTS to use
# the approved hosts in owl/settings.py. Uncomment to replace that list with
# comma-separated exact hostnames (not URLs or paths), then restart OWL and its
# workers. An explicitly blank value disables repository adds.
# BITBUCKET_ALLOWED_HOSTS=bitbucket.org,github.com,scm.example.invalid
BITBUCKET_HISTORY_YEARS=3
BITBUCKET_MAX_REPO_WORKERS=5
BITBUCKET_GIT_TIMEOUT_SECONDS=3600
BITBUCKET_WORKER_IDLE_SECONDS=15
# Daily cycles follow OWL_TIME_ZONE. The retry cap is in addition to the initial attempt.
BITBUCKET_DAILY_REFRESH_ENABLED=true
BITBUCKET_DAILY_REFRESH_LOCAL_HOUR=11
BITBUCKET_DAILY_REFRESH_RETRY_SECONDS=7200
BITBUCKET_DAILY_REFRESH_MAX_RETRIES=3
BITBUCKET_PDF_PAGE_SIZE=200
BITBUCKET_SEARCH_PAGE_SIZE=200
PDF_MAX_EXTRACTION_WORKERS=
PDF_EXTRACTION_TIMEOUT_SECONDS=600
PDF_EXTRACTION_WORKER_IDLE_SECONDS=15
PDF_EXTRACTION_MAX_AUTOMATIC_RETRIES=2
BITBUCKET_SUPERVISOR_POLL_SECONDS=5
PDF_MAX_FILE_BYTES=2147483648
PDF_MAX_PAGES=10000
PDF_MAX_PAGE_TEXT_CHARS=2000000
PDF_MAX_TOTAL_TEXT_CHARS=100000000
PDF_MAX_PROCESS_MEMORY_BYTES=1073741824

# Display and safety thresholds.
NEW_DURATION_DAYS=30
UPDATED_DURATION_DAYS=30
OPEN_ALL_CONFIRM_THRESHOLD=10

# Live external tests are always off unless deliberately enabled on a local
# machine. Public CI overrides this value to false as an additional safeguard.
OWL_ALLOW_LIVE_EXTERNAL_TESTS=false
